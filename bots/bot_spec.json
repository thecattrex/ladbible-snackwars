{
  "version": 3,
  "clip_bots": [
    {
      "bot": "ingest",
      "count": 1
    },
    {
      "bot": "slice",
      "count": 1,
      "unit_seconds": 90
    },
    {
      "bot": "transcribe",
      "count": 1,
      "cache": "assets/words_all.json"
    },
    {
      "bot": "judge",
      "count": 40,
      "axes": [
        "hook_strength",
        "emotion",
        "reaction",
        "quotability",
        "replay_value",
        "hook_inside_clip",
        "someone_on_camera",
        "pacing",
        "gaffe",
        "story_complete"
      ]
    },
    {
      "bot": "heatmap",
      "count": 1,
      "only": "youtube"
    },
    {
      "bot": "superbot",
      "count": 1,
      "rules": [
        "majority+strongest signal",
        "spread across whole video",
        "no duplicate hook"
      ]
    },
    {
      "bot": "assign",
      "count": 1
    }
  ],
  "edit_bots": [
    "hook_bot",
    "cut_bot",
    "framing_bot",
    "caption_bot",
    "sfx_bot",
    "render_bot"
  ],
  "qc_bots": [
    "review_bot",
    "fixer_bot",
    "gate"
  ],
  "acceptance": {
    "resolution": [
      1080,
      1920
    ],
    "fps": 30,
    "min_duration_s": 15.0,
    "face_pct_min": 0.9,
    "nobody_gap_max_s": 0.7,
    "audio_required": true,
    "watermark": "bottom-left untouched",
    "hook": "<=8 words, real, inside clip, unique"
  },
  "worker_model": {
    "type": "one_os_process_per_clip",
    "encode": "libx264 -threads 1",
    "local_slots": "2 (2-core sandbox)",
    "github": "1 runner per clip, 20 in parallel"
  },
  "reference_pair": {
    "bad": "references/GALAT_bad_example.mp4",
    "bad_face_pct": 0.61,
    "bad_gap_s": 2.7,
    "good": "references/SAHI_good_example.mp4",
    "good_face_pct": 0.994,
    "good_gap_s": 0.1,
    "compare": "references/COMPARE_bad_vs_good.mp4"
  }
}